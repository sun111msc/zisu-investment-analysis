# 紫苏投资分析 — 环境变量示例
#
# 复制为 .env 后按需填写：cp .env.example .env
#
# 重要：核心库运行时零第三方依赖，以下全部为**可选**配置。
#      不配置任何变量，examples/ 与测试即可完整运行（使用内置示例数据）。

# ─────────────────────────────────────────────
# LLM（可选）
# 仅在需要让模型生成分析产物的自然语言部分时配置。
# 框架本身负责纪律与计算，不依赖 LLM 也能跑通全部闸门。
# ─────────────────────────────────────────────
ZISU_LLM_PROVIDER=
ZISU_LLM_API_KEY=
ZISU_LLM_MODEL=
ZISU_LLM_BASE_URL=

# ─────────────────────────────────────────────
# 数据源（可选）
# 接入真实数据时配置。未配置时使用 examples/cases/ 中的示例数据。
#
# 注意：接入前需在 src/zisu/datasources/registry.py 中登记该源的能力边界，
#      未登记的数据源会被 GATE-01 直接拒绝 —— 这是故意的设计。
# ─────────────────────────────────────────────
ZISU_DS_MARKET_PRIMARY_URL=
ZISU_DS_MARKET_PRIMARY_KEY=
ZISU_DS_MARKET_BACKUP_URL=
ZISU_DS_MARKET_BACKUP_KEY=
ZISU_DS_FINANCIALS_PRIMARY_URL=
ZISU_DS_FINANCIALS_PRIMARY_KEY=
ZISU_DS_FINANCIALS_BACKUP_URL=
ZISU_DS_FINANCIALS_BACKUP_KEY=
ZISU_DS_RESEARCH_URL=
ZISU_DS_RESEARCH_KEY=

# ─────────────────────────────────────────────
# 运行配置（可选）
# ─────────────────────────────────────────────
# 取数审计日志路径
ZISU_AUDIT_LOG=evals/reports/fetch_audit.jsonl

# 日志级别：DEBUG / INFO / WARNING / ERROR
ZISU_LOG_LEVEL=INFO

# 是否启用严格闸门模式（默认 true）
# ⚠️ 设为 false 只影响输出详略，**不会**关闭任何阻断型闸门 —— 闸门没有全局跳过开关。
ZISU_STRICT_GATES=true

# 评测基线路径
ZISU_BASELINE=evals/baselines.json
